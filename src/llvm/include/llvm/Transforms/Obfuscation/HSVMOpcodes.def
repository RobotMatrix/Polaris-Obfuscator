//===- HSVMOpcodes.def - HSV virtual ISA opcode table ----*- C mode -*-===//
//
// SINGLE SOURCE OF TRUTH for the HSV virtual instruction set.
//
// This file is included by:
//   * research/hsvm/include/hsvm/isa.h   (mirror, generated by
//     research/hsvm/tools/sync_isa.py --write)
//   * the compiler pass (M3) once it exists
//
// Format: HSV_OPCODE(EnumName, Value). Values must be unique and fit in u8.
// Changing this file requires regenerating the mirror; ctest's sync_isa check
// fails when the two drift apart.
//
//===----------------------------------------------------------------------===//

HSV_OPCODE(Nop, 0x00)
HSV_OPCODE(Movi, 0x01)
HSV_OPCODE(Mov, 0x02)
HSV_OPCODE(Add, 0x03)
HSV_OPCODE(Sub, 0x04)
HSV_OPCODE(Xor, 0x05)
HSV_OPCODE(And, 0x06)
HSV_OPCODE(Or, 0x07)
HSV_OPCODE(Shl, 0x08)
HSV_OPCODE(Shr, 0x09)
HSV_OPCODE(Mul, 0x0A)
HSV_OPCODE(Ld, 0x0B)
HSV_OPCODE(St, 0x0C)
HSV_OPCODE(Jmp, 0x0D)
HSV_OPCODE(Brz, 0x0E)
// ISA v2: Tld reads a word from the host table (not the 4 KiB VM memory).
HSV_OPCODE(Tld, 0x10)
HSV_OPCODE(Halt, 0x0F)
