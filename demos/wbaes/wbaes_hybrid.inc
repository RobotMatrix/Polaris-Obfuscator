// 烘焙数据面：全部轮次都在表里。运行时没有 S 盒，也没有轮密钥异或。
#include "hy_seal.h" // generated by gen_hybrid.cpp next to hy_table.bin
#include "hy_in.h"
#include "hy_mask.h"
#ifdef WBAES_HAVE_VM
#include "wbaes_vm.h" // HSV bytecode that computes the per-round table offsets
#endif

// Table integrity: one full pass the first time, a sampled pass afterwards. A
// modified table (data fault or patched binary image) is caught here instead of
// silently producing wrong ciphertexts both traversals agree on.
// Lookups go through a pointer so the unmasker can swap in a writable copy:
// writing to a const object is UB and -O2 exploits it (the same source gives the
// right answer at -O0).
static uint8_t hy_tab_buf[HY_TABLE_BYTES];
static const uint8_t *hy_tab_ptr = kHyTab;
#define HYKTAB hy_tab_ptr
static int hy_seal_full_done = 0;
static uint32_t hy_seal_hash(uint32_t stride) {
    uint32_t h = 2166136261u;
    for (uint32_t i = 0; i < HY_TABLE_BYTES; i += stride) {
        h ^= HYKTAB[i];
        h *= 16777619u;
    }
    return h;
}
static int hy_table_unmasked = 0;
// The round schedule is data in the table, so it can be damaged like any other
// byte; the generator writes a per-direction check byte next to it. A wrong
// schedule would make a round read a neighbour's layout and produce a wrong
// ciphertext that both DFA traversals agree on, which is why it is checked here.
static int hy_sched_valid(void) {
    for (uint32_t d = 0; d < 2; d++) {
        const uint8_t *g = HYKTAB + HY_SCHED_OFF + d * HY_SCHED_STRIDE;
        uint8_t x = (uint8_t)d;
        for (int r = 0; r < HY_MC_ROUNDS; r++) x ^= g[r];
        if (g[HY_MC_ROUNDS] != x) return 0;
    }
    return 1;
}
static void hy_table_unmask(void) {
    // Four words that only make sense together; nothing here is a function of
    // the key, and no single immediate equals the seed.
    uint32_t st = HY_SEED_FRAG[0] ^ HY_SEED_FRAG[1] ^ HY_SEED_FRAG[2] ^ HY_SEED_FRAG[3];
    for (uint32_t i = 0; i < HY_TABLE_BYTES; i++) {
        hy_tab_buf[i] = (uint8_t)(hy_tab_ptr[i] ^ hy_mask_next(&st));
    }
    hy_tab_ptr = hy_tab_buf;
}
static int hy_table_intact(void) {
    if (hy_seal_full_done) return hy_table_unmasked;
    hy_seal_full_done = 1;
#ifdef HY_DEBUG
    fprintf(stderr, "[hy] full=%08x want=%08x s4096=%08x want=%08x\n",
            hy_seal_hash(1), HY_TABLE_SEAL, hy_seal_hash(4096), HY_TABLE_SEAL_S4096);
#endif
    if (hy_seal_hash(1) != HY_TABLE_SEAL) return 0;
    if (hy_seal_hash(4096) != HY_TABLE_SEAL_S4096) return 0;
    hy_table_unmask();
    hy_table_unmasked = 1;
    if (hy_seal_hash(4096) != HY_TABLE_SEAL_S4096_P) return 0; // wrong seed
    if (!hy_sched_valid()) return 0;                           // round schedule damaged
#ifdef WBAES_HAVE_VM
    // Tld reads the schedule block out of this (now unmasked) buffer. Before the
    // unmask it would read ciphertext, so the pointer is set here and nowhere
    // else; HY_SCHED_OFF is 4-aligned, which Tld requires.
    hy_vm_set_table(HYKTAB + HY_SCHED_OFF, HY_SCHED_BYTES);
#endif
#ifdef HY_DEBUG
    {
        uint32_t h = 2166136261u;
        for (int i = 0; i < 4096; i++) { h ^= HYKTAB[i]; h *= 16777619u; }
        fprintf(stderr, "[hy] head4k=%08x\n", h);
    }
#endif
    return 1;
}
#ifdef WBAES_DFA_SELFTEST
// Test-only hook: corrupt the first traversal's state once, to prove the second
// traversal and the comparison catch a single-byte fault. Not compiled into the
// shipped binary.
static int g_dfa_once = 1;
#endif

#ifdef WBAES_HAVE_VM
// Sixteen table offsets per round, for both directions, computed by the HSV
// bytecode at the start of every block. They are loop-invariant, and that is
// exactly why they are recomputed per block: the addresses a block reads are
// the ones the VM produced for that block, so a schedule byte the VM consumes
// changes the ciphertext instead of being checked and then ignored.
static int hy_vm_plan(int dir, uint32_t off[HY_MC_ROUNDS][16]) {
    for (int r = 0; r < HY_MC_ROUNDS; r++) {
        if (hy_vm_offsets(dir, r, off[r]) != 0) return -1; // VM faulted
        for (int i = 0; i < 16; i++)
            if (off[r][i] > HY_TOTAL - HY_U32) return -1; // would read past the table
    }
    return 0;
}
#endif

// One traversal of the table network, factored out so the encryption path can run
// it twice over independent buffers.
static void hy_encrypt_once(const uint8_t in[16], uint8_t out[16], uint32_t env,
                            int arm_fault, const uint32_t (*off)[16]) {
    uint8_t s[16], n[16];
    for (int i = 0; i < 16; i++) s[i] = HY_P0[i][in[i]]; // round-0 input bijection
    for (int r = 0; r < HY_MC_ROUNDS; r++) {
        // hy_mc_round reads this round's family out of the table: the nine rounds
        // do not have to share a table shape, and the loop does not know which.
        // off[r] is the VM's offset plan for that round (nullptr: derive it here).
        hy_mc_round(HYKTAB, hy_enc_col(r, 0), r, 0, 1, s, n, env, off ? off[r] : nullptr);
        for (int i = 0; i < 16; i++) s[i] = n[i];
    }
    if (arm_fault) {
#ifdef WBAES_DFA_SELFTEST
        if (g_dfa_once) {
            g_dfa_once = 0;
            s[7] ^= 0x40u; // the shape of a DFA fault: one state byte
        }
#else
        (void)arm_fault;
#endif
    }
    hy_pair_map(HYKTAB, hy_enc_final(), s, out, env, 0, 9, 1);
}

// DFA defense: the whole network runs twice over independent buffers and the two
// ciphertexts must agree. A single injected fault lands in one traversal, the
// comparison fails, and the caller gets garbage instead of a faulty ciphertext -
// which is what a differential attack needs. Cost: 2x table traffic.
static void hy_encrypt(const uint8_t in[16], uint8_t out[16]) {
    uint32_t env = g_env ^ g_poison;
    if (!hy_table_intact()) {
        wbaes_key::g_key_tampered |= 0x8000u;
        for (int i = 0; i < 16; i++) out[i] = (uint8_t)(wb_runtime_rand() & 0xFF);
        return;
    }
#ifdef WBAES_HAVE_VM
    uint32_t off[HY_MC_ROUNDS][16];
    if (hy_vm_plan(0, off) != 0) { // VM fault: no offsets, no ciphertext
        wbaes_key::g_key_tampered |= 0x8000u;
        for (int i = 0; i < 16; i++) out[i] = (uint8_t)(wb_runtime_rand() & 0xFF);
        return;
    }
    const uint32_t(*poff)[16] = off;
#else
    const uint32_t(*poff)[16] = nullptr;
#endif
    uint8_t ct1[16], ct2[16];
    hy_encrypt_once(in, ct1, env, 1, poff);
    hy_encrypt_once(in, ct2, env, 0, poff);
    if (memcmp(ct1, ct2, 16) != 0) {
        wbaes_key::g_key_tampered |= 0x8000u; // detected: never emit either one
        for (int i = 0; i < 16; i++) out[i] = (uint8_t)(wb_runtime_rand() & 0xFF);
        return;
    }
    for (int i = 0; i < 16; i++) out[i] = ct1[i];
}

static void hy_decrypt_once(const uint8_t in[16], uint8_t out[16], uint32_t env,
                            const uint32_t (*off)[16]) {
    uint8_t s[16], t[16], n[16];
    hy_pair_map(HYKTAB, hy_dec_entry(), in, s, env, 1, 0, 2);
    for (int step = 0; step < HY_DEC_STEPS; step++) {
        hy_mc_round(HYKTAB, hy_dec_mc(step), step, 1, 0, s, t, env,
                    off ? off[step] : nullptr);
        hy_pair_map(HYKTAB, hy_dec_sb(step), t, n, env, 1, 20 + step, 2);
        for (int i = 0; i < 16; i++) s[i] = n[i];
    }
    hy_pair_map(HYKTAB, hy_dec_tail(), s, out, env, 1, 40, 0);
}

// Same DFA defense as the encryption path: decryption faults leak the round keys
// just as well, so the network runs twice and both results must agree.
static void hy_decrypt(const uint8_t in[16], uint8_t out[16]) {
    uint32_t env = g_env ^ g_poison;
    if (!hy_table_intact()) {
        wbaes_key::g_key_tampered |= 0x8000u;
        for (int i = 0; i < 16; i++) out[i] = (uint8_t)(wb_runtime_rand() & 0xFF);
        return;
    }
#ifdef WBAES_HAVE_VM
    uint32_t off[HY_MC_ROUNDS][16];
    if (hy_vm_plan(1, off) != 0) {
        wbaes_key::g_key_tampered |= 0x8000u;
        for (int i = 0; i < 16; i++) out[i] = (uint8_t)(wb_runtime_rand() & 0xFF);
        return;
    }
    const uint32_t(*poff)[16] = off;
#else
    const uint32_t(*poff)[16] = nullptr;
#endif
    uint8_t pt1[16], pt2[16];
    hy_decrypt_once(in, pt1, env, poff);
    hy_decrypt_once(in, pt2, env, poff);
    if (memcmp(pt1, pt2, 16) != 0) {
        wbaes_key::g_key_tampered |= 0x8000u;
        for (int i = 0; i < 16; i++) out[i] = (uint8_t)(wb_runtime_rand() & 0xFF);
        return;
    }
    for (int i = 0; i < 16; i++) out[i] = pt1[i];
}

static void hy_protect(const uint8_t in[16], uint8_t out[16], int dec) {
    if (dec) hy_decrypt(in, out);
    else hy_encrypt(in, out);
}

#ifdef WBAES_VM_SCHEDTEST
// Test-only (not in the shipped build): damage one byte of the schedule block in
// the unmasked table, after the one-time seal pass has already run. Byte 48 is
// the low byte of the column-stride word the VM multiplies by the column index.
// No C++ code reads that byte - the schedule checksum covers only the family
// bytes, and the sampled seal looks at every 4096th table byte - so if the
// ciphertext changes here, the offsets the reader used came from the VM.
static void hy_test_flip_sched(void) { hy_tab_buf[HY_SCHED_OFF + 48] ^= 0x01; }
#endif
